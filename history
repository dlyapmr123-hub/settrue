        let currentEditEvent = null;
        let holdTimer = null;

        function openAdminModal(eventId) {
            if (!eventId) return;
            const event = historySignals.find(e => String(e._id) === String(eventId));
            if (!event) return;
            currentEditEvent = event;
            document.getElementById('modalMatchInfo').textContent = `📅 ${event.date} | ${event.home} — ${event.away}`;
            document.getElementById('adminPassword').value = '';
            document.getElementById('passwordError').classList.remove('show');
            document.getElementById('adminModal').classList.add('active');
            setTimeout(() => document.getElementById('adminPassword').focus(), 100);
        }

        function closeAdminModal() {
            document.getElementById('adminModal').classList.remove('active');
            currentEditEvent = null;
        }

        function startHold(eventId) {
            if (holdTimer) clearTimeout(holdTimer);
            holdTimer = setTimeout(() => {
                holdTimer = null;
                openAdminModal(eventId);
            }, 5000);
        }

        function cancelHold() {
            if (holdTimer) { clearTimeout(holdTimer); holdTimer = null; }
        }

        function setResult(result) {
            const password = document.getElementById('adminPassword').value;
            if (password !== '123qwe') {
                document.getElementById('passwordError').classList.add('show');
                document.getElementById('adminPassword').value = '';
                document.getElementById('adminPassword').focus();
                return;
            }
            if (!currentEditEvent) return;
            currentEditEvent._result = result;
            saveHistoryToStorage();
            renderHistoryTable(historySignals);
            document.getElementById('historyCountBadge').textContent = historySignals.length;
            updateDashboard();
            closeAdminModal();
        }

