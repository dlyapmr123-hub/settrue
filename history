        async function loadCashflowsFromFile() {
            try {
                const response = await fetch('/cashflows_data.json?t=' + Date.now());
                if (response.ok) { const data = await response.json(); if (data.football && data.tennis) return data; }
                return null;
            } catch (e) { return null; }
        }

        async function loadCashflowsFromAPI() {
            const apis = {
                football: 'https://script.google.com/macros/s/AKfycbx3gwPpCEyxZCbc8nh1rq6bf7gPztOWRoMbgE506I0M33P4hI4fgXktKaya8jOj5zYm/exec',
                tennis: 'https://script.google.com/macros/s/AKfycbyPfWZiu8kGFSLw6MGLCPpQf5sg2Gv9q6CFixRZVXwyBrZ0-3MTnOEFLHZOQMv_PCg1/exec',
                basketball: 'https://script.google.com/macros/s/AKfycbyCtAh2TuDbU9uDOi3Qmvpt-tofaqo1FvAQQF4dPhBl3MMdu5gcEJ0Q56lrUIIoWp09/exec',
                baseball: 'https://script.google.com/macros/s/AKfycbwKbDd81v796ZrECcCC2Of7LVtCJmnbOx3d_c6DYARq_IT8Z0r_elRqWw7K7eau0Q6I/exec'
            };
            const result = {};
            for (const [name, url] of Object.entries(apis)) {
                try { const r = await fetch(url); result[name] = await r.json(); }
                catch (e) { result[name] = { success: false, error: e.message, data: [] }; }
            }
            return result;
        }

        function checkSignal(event, sport) {
            const hasDraw = sport === 'football';
            const keys = hasDraw ? ['home', 'draw', 'away'] : ['home', 'away'];
            const totalVolume = parseFloat(event.volume) || 0;
            if (totalVolume < 50000) return null;
            let signals = [];
            keys.forEach(key => {
                const odds = event.odds[key];
                if (!odds) return;
                const value = parseFloat(odds.value);
                const money = parseFloat(odds.money) || 0;
                if (value < 1.50) return;
                if ((money / totalVolume) * 100 < 80) return;
                signals.push({ key, odds, volumePercent: (money/totalVolume)*100, money });
            });
            if (signals.length === 0) return null;
            return { ...event, hasDraw, signals, _sport: sport, _timestamp: Date.now(), _result: null, _id: generateId() };
        }

        // ============================================================
        // 5. DASHBOARD (FLAT = 1000)
        // ============================================================
        const MONTH_RU = { Jan:'Янв', Feb:'Фев', Mar:'Мар', Apr:'Апр', May:'Май', Jun:'Июн', Jul:'Июл', Aug:'Авг', Sep:'Сен', Oct:'Окт', Nov:'Ноя', Dec:'Дек' };
        const MONTH_ORDER = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        const STAKE = 1000; // ИЗМЕНЕНО НА 1000

        function getMonthKey(dateStr) {
            if (!dateStr) return null;
            const parts = dateStr.trim().split(/[\s,]+/);
            const mon = parts[0];
            if (MONTH_ORDER.indexOf(mon) === -1) return null;
            return mon + ' ' + new Date().getFullYear();
        }

        function getSignalOddsValue(event) {
            if (!event.signals || !event.signals.length || !event.odds) return 0;
            const o = event.odds[event.signals[0].key];
            return o ? parseFloat(o.value) || 0 : 0;
        }

        function updateDashboard() {
            let totalBalance = 0, wins = 0, losses = 0, pending = 0;
            const months = {};

            historySignals.forEach(ev => {
                const mk = getMonthKey(ev.date);
                if (!months[mk]) months[mk] = { balance: 0, bets: 0 };

                if (ev._result === 'win') {
                    const profit = STAKE * getSignalOddsValue(ev);
                    totalBalance += profit; wins++;
                    months[mk].balance += profit; months[mk].bets++;
                } else if (ev._result === 'loss') {
                    totalBalance -= STAKE; losses++;
                    months[mk].balance -= STAKE; months[mk].bets++;
                } else {
                    pending++;
                }
            });

            const totalBets = wins + losses;
            const totalStaked = totalBets * STAKE;
            const roi = totalStaked > 0 ? ((totalBalance - totalStaked) / totalStaked * 100) : 0;

            const balEl = document.getElementById('dashBalance');
            const sign = totalBalance > 0 ? '+' : '';
            balEl.textContent = '£' + sign + Math.round(totalBalance).toLocaleString();
            balEl.className = 'value ' + (totalBalance > 0 ? 'pos' : totalBalance < 0 ? 'neg' : 'zero');

            const roiEl = document.getElementById('dashRoi');
            const roiSign = roi > 0 ? '+' : '';
            roiEl.textContent = roiSign + roi.toFixed(1) + '%';
            roiEl.className = 'val ' + (roi > 0 ? 'g' : roi < 0 ? 'r' : 'm');

            document.getElementById('dashBets').textContent = totalBets;
            document.getElementById('dashWins').textContent = wins;
            document.getElementById('dashLosses').textContent = losses;
            document.getElementById('dashPending').textContent = pending;

            const container = document.getElementById('dashChart');
            const keys = Object.keys(months).sort((a, b) => {
                const [ma, ya] = a.split(' '); const [mb, yb] = b.split(' ');
                if (ya !== yb) return parseInt(ya) - parseInt(yb);
                return MONTH_ORDER.indexOf(ma) - MONTH_ORDER.indexOf(mb);
            });

            if (keys.length === 0) { container.innerHTML = '<div class="dash-empty">Нет завершённых ставок</div>'; return; }

            const maxAbs = Math.max(...keys.map(k => Math.abs(months[k].balance)), 1);
            const maxBarH = 40;
            let html = '';
            keys.forEach(k => {
                const m = months[k];
                const mon = k.split(' ')[0];
                const label = MONTH_RU[mon] || mon;
                const isPos = m.balance >= 0;
                const h = Math.max(2, Math.round((Math.abs(m.balance) / maxAbs) * maxBarH));
                const signB = m.balance > 0 ? '+' : '';
                html += `<div class="dash-bar-wrap">
                    <div class="dash-bar-val ${isPos ? 'pos' : 'neg'}">${signB}${Math.round(m.balance)}</div>
                    <div class="dash-bar ${isPos ? 'pos' : 'neg'}" style="height:${h}px;"></div>
                    <div class="dash-bar-lbl">${label}</div>
                </div>`;
            });
            container.innerHTML = html;
        }

        // ============================================================
        // 6. RENDERING
        // ============================================================
        async function loadSignalsData() {
            const container = document.getElementById('signalsContainer');
            container.innerHTML = '<div class="loading-state"><div class="loading-pulse"></div><div class="loading-text">Анализ потоков...</div></div>';
            try {
                let data = await loadCashflowsFromFile();
                if (!data) data = await loadCashflowsFromAPI();
                if (!data) { container.innerHTML = '<div class="empty-state">❌ Ошибка загрузки</div>'; return; }

                const signalEvents = [];
                ['football','tennis','basketball','baseball'].forEach(sport => {
                    const r = data[sport];
                    if (r && r.success && r.data && r.data.length > 0) {
                        r.data.forEach(ev => { const c = checkSignal(ev, sport); if (c) signalEvents.push(c); });
                    }
                });

                allSignalsData = signalEvents;
                renderSignalsTable(signalEvents);
                document.getElementById('badgeSignals').textContent = signalEvents.length;
                document.getElementById('signalsCountBadge').textContent = signalEvents.length;

                signalEvents.forEach(cur => {
                    const idx = historySignals.findIndex(h =>
                        (h.home||'').trim().toLowerCase() === (cur.home||'').trim().toLowerCase() &&
                        (h.away||'').trim().toLowerCase() === (cur.away||'').trim().toLowerCase() &&
                        h.date === cur.date
                    );
                    if (idx !== -1) {
                        const saved = historySignals[idx]._result;
                        historySignals[idx] = { ...cur, _result: saved };
                    } else {
                        historySignals.push(cur);
                    }
                });
                
                saveHistoryToStorage();
                renderHistoryTable(historySignals);
                document.getElementById('historyCountBadge').textContent = historySignals.length;
                updateDashboard();
            } catch(e) { container.innerHTML = '<div class="empty-state">❌ ' + e.message + '</div>'; }
        }

        function renderSignalsTable(events) {
            const c = document.getElementById('signalsContainer');
            if (!events.length) { c.innerHTML = '<div class="empty-state">📭 Нет сигналов</div>'; return; }
            const sorted = [...events].sort((a,b) => (parseFloat(b.volume)||0) - (parseFloat(a.volume)||0));
            const em = { football:'⚽', tennis:'🎾', basketball:'🏀', baseball:'⚾' };
            let h = '<table class="data-table"><tbody>';
            sorted.forEach(ev => {
                const hd = ev.hasDraw || false;
                const keys = hd ? ['home','draw','away'] : ['home','away'];
                const tv = parseFloat(ev.volume)||0;
                const sk = ev.signals.map(s=>s.key);
                h += `<tr class="row-signal"><td class="col-event"><div class="ev-stack"><div class="ev-top"><span class="ev-date">${ev.date||''}</span><span class="ev-league">${em[ev._sport]||'📊'} ${ev.league||''}</span><span style="color:var(--green);font-size:9px;font-weight:700;background:var(--badge-bg);padding:1px 10px;border-radius:12px;">SIGNAL</span></div><div class="ev-match"><span>${ev.home||''}</span><span class="ev-dash">—</span><span>${ev.away||''}</span></div></div></td>`;
                keys.forEach(key => {
                    const o = ev.odds[key];
                    if (!o) { h += '<td><div class="odds-cell"><div class="odds-value">—</div></div></td>'; return; }
                    const v = parseFloat(o.value)||''; const s = parseFloat(o.signal)||0; const m = parseFloat(o.money)||0;
                    const is = sk.includes(key); const p = tv>0?((m/tv)*100).toFixed(1):0;
                    let cl = ''; if(is){if(p>=90)cl='signal-mega';else if(p>=85)cl='signal-strong';else cl='signal-high';}
                    h += `<td><div class="odds-cell"><div class="odds-value">${v}</div><div class="odds-signal ${cl}"><strong>${s}%</strong> ${is?'🔥':''}</div><div class="odds-money">£${m.toLocaleString()}</div></div></td>`;
                });
                h += `<td class="col-volume"><div class="volume-value">£${tv.toLocaleString()}</div><div class="volume-label">объём</div></td></tr>`;
            });
            h += '</tbody></table>'; c.innerHTML = h;
        }

        function renderHistoryTable(events) {
            const c = document.getElementById('historyContainer');
            if (!events.length) { c.innerHTML = '<div class="empty-state">📭 Нет истории</div>'; return; }
            const sorted = [...events].sort((a,b) => (b._timestamp||0) - (a._timestamp||0));
            const em = { football:'⚽', tennis:'🎾', basketball:'🏀', baseball:'⚾' };
            const hold = `onmousedown="startHold('\${ID}')" onmouseup="cancelHold()" onmouseleave="cancelHold()" ontouchstart="startHold('\${ID}')" ontouchend="cancelHold()" ontouchcancel="cancelHold()"`;
            let h = '<table class="data-table"><tbody>';
            sorted.forEach(ev => {
                const sk = ev.signals ? ev.signals.map(s=>s.key) : [];
                const emoji = em[ev._sport]||'📊';
                const tv = parseFloat(ev.volume)||0;
                const hh = hold.replace(/\$\{ID\}/g, ev._id);

                let res = '';
                if (ev._result === 'win') res = `<span class="result-badge result-win" ${hh}>✅ Выигрыш</span>`;
                else if (ev._result === 'loss') res = `<span class="result-badge result-loss" ${hh}>❌ Проигрыш</span>`;
                else res = `<span class="result-badge result-pending" ${hh}>⏳ Ожидание</span>`;

                // ИЗМЕНЁННЫЙ ДИЗАЙН КЭФОВ: подсвечивается только число и огонёк
                let oddsH = '';
                if (ev.odds) {
                    const keys = ev.hasDraw ? ['home','draw','away'] : ['home','away'];
                    const labels = ev.hasDraw ? ['1','X','2'] : ['1','2'];
                    const items = [];
                    keys.forEach((key, i) => {
                        const o = ev.odds[key]; if (!o) return;
                        const is = sk.includes(key);
                        const labelColor = 'var(--text-secondary)';
                        const valueColor = is ? 'var(--green)' : 'var(--text-primary)';
                        const fire = is ? ' 🔥' : '';
                        items.push(`
                            <span style="color:${labelColor}; font-weight:500;">${labels[i]}:</span>
                            <span style="color:${valueColor}; font-weight:700; margin-left:2px;">${o.value}${fire}</span>
                        `);
                    });
                    oddsH = `<div style="display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;font-size:13px;letter-spacing:0.3px;">${items.join('<span style="color:var(--border-color);font-weight:300; margin:0 2px;">·</span>')}</div>`;
                }

                let sigTxt = '';
                if (sk.length > 0) {
                    const lb = sk.map(k => k==='home'?(ev.home||'1'):k==='draw'?'X':k==='away'?(ev.away||'2'):k);
                    sigTxt = `Сигнал: <strong>${lb.join(' + ')}</strong>`;
                }

                h += `<tr class="row-signal">
                    <td class="col-event" style="min-width:160px;"><div class="ev-stack"><div class="ev-top"><span class="ev-date">${ev.date||''}</span><span class="ev-league">${emoji} ${ev.league||''}</span></div><div class="ev-match" style="font-size:13px;"><span>${ev.home||''}</span><span class="ev-dash">—</span><span>${ev.away||''}</span></div><div style="font-size:10px;color:var(--green);margin-top:4px;">${sigTxt}</div></div></td>
                    <td style="text-align:center;padding:12px 8px;min-width:180px;">${oddsH}</td>
                    <td style="text-align:center;min-width:110px;">${res}</td>
                    <td class="col-volume" style="text-align:center;"><div class="volume-value">£${tv.toLocaleString()}</div><div class="volume-label">объём</div></td>
                </tr>`;
            });
            h += '</tbody></table>'; c.innerHTML = h;
        }

        async function loadSportData(sport) {
            const c = document.getElementById(sport+'Container');
            c.innerHTML = '<div class="loading-state"><div class="loading-pulse"></div><div class="loading-text">Загрузка...</div></div>';
            try {
                let data = await loadCashflowsFromFile();
                if (!data) data = await loadCashflowsFromAPI();
                if (data && data[sport] && data[sport].success) {
                    const container = document.getElementById(sport+'Container');
                    const b = document.getElementById('badge'+sport.charAt(0).toUpperCase()+sport.slice(1));
                    const evs = data[sport].data||[];
                    if (b) b.textContent = evs.length;
                    if (!evs.length) { container.innerHTML = '<div class="empty-state">📭 Нет данных</div>'; return; }
                    const sorted = [...evs].sort((a,b) => (parseFloat(b.volume)||0)-(parseFloat(a.volume)||0));
                    const isF = sport==='football';
                    let h = `<table class="data-table"><thead><tr><th>Дата / Матч</th><th>1</th>${isF?'<th>X</th>':''}<th>2</th><th class="col-volume">Объём</th></tr></thead><tbody>`;
                    sorted.forEach(e => {
                        const hv=e.odds.home, av=e.odds.away, dv=isF?e.odds.draw:null;
                        const v=e.volume?'£'+Number(e.volume).toLocaleString():'—';
                        h += `<tr><td class="col-event"><div class="ev-stack"><div class="ev-top"><span class="ev-date">${e.date||''}</span><span class="ev-league">${e.league||''}</span></div><div class="ev-match"><span>${e.home||''}</span><span class="ev-dash">—</span><span>${e.away||''}</span></div></div></td>
                        <td><div class="odds-cell"><div class="odds-value">${hv.value||''}</div><div class="odds-signal"><strong>${hv.signal||'0'}%</strong></div><div class="odds-money">£${hv.money||'0'}</div></div></td>`;
                        if(isF) h += `<td><div class="odds-cell"><div class="odds-value">${dv?dv.value:''}</div><div class="odds-signal"><strong>${dv?dv.signal:'0'}%</strong></div><div class="odds-money">£${dv?dv.money:'0'}</div></div></td>`;
                        h += `<td><div class="odds-cell"><div class="odds-value">${av.value||''}</div><div class="odds-signal"><strong>${av.signal||'0'}%</strong></div><div class="odds-money">£${av.money||'0'}</div></div></td>
                        <td class="col-volume"><div class="volume-value">${v}</div><div class="volume-label">объём</div></td></tr>`;
                    });
                    h += '</tbody></table>'; container.innerHTML = h;
                } else {
                    c.innerHTML = '<div class="empty-state">❌ Нет данных</div>';
                }
            } catch(e) { c.innerHTML = '<div class="empty-state">❌ '+e.message+'</div>'; }
        }
        function loadFootballData() { return loadSportData('football'); }
        function loadTennisData() { return loadSportData('tennis'); }
        function loadBasketballData() { return loadSportData('basketball'); }
        function loadBaseballData() { return loadSportData('baseball'); }

        let autoUpdateInterval = null;
        function startAutoUpdate() {
            if (autoUpdateInterval) clearInterval(autoUpdateInterval);
            autoUpdateInterval = setInterval(() => {
                if (!document.hidden) {
                    const id = document.querySelector('.tab-content.active')?.id;
                    if (id === 'tabSignals') loadSignalsData();
                    else if (id === 'tabFootball') loadFootballData();
                    else if (id === 'tabTennis') loadTennisData();
                    else if (id === 'tabBasketball') loadBasketballData();
                    else if (id === 'tabBaseball') loadBaseballData();
                }
            }, 60000);
        }

        document.addEventListener('DOMContentLoaded', function() {
            initDefaultHistory();
            updateDashboard();
            loadSignalsData();
            loadFootballData();
            loadTennisData();
            loadBasketballData();
            loadBaseballData();
            startAutoUpdate();
        });
    </script>
</body>
</html>
